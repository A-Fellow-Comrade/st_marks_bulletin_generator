<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="st_mark_bulletin_generator.Views.CoverImagePickerWindow"
        Title="Choose Cover Image"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Window.Styles>
        <Style Selector="Border.thumb">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.thumb:pointerover">
            <Setter Property="BorderBrush" Value="#888"/>
        </Style>
        <Style Selector="Border.thumb.selected">
            <Setter Property="BorderBrush" Value="#0078D4"/>
        </Style>
    </Window.Styles>

    <StackPanel Margin="16" Spacing="12">

        <TextBlock Text="Select a cover image, or leave it on Random."
                   TextWrapping="Wrap" Opacity="0.75"/>

        <!-- Random option -->
        <Border x:Name="RandomBorder" Classes="thumb selected"
                Width="120" HorizontalAlignment="Left"
                PointerPressed="RandomBorder_PointerPressed">
            <StackPanel Height="90" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                <TextBlock Text="🎲" FontSize="28" HorizontalAlignment="Center"/>
                <TextBlock Text="Random" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Thumbnail grid -->
        <WrapPanel x:Name="ThumbPanel" Orientation="Horizontal"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK"     Width="80" Click="Ok_Click"/>
            <Button Content="Cancel" Width="80" Click="Cancel_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
