<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="st_mark_bulletin_generator.Views.CoverImagePickerWindow"
        Title="Choose Cover Image"
        Width="700" Height="600" MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource SurfaceBrush}">

    <Window.Styles>
        <Style Selector="Button.thumb">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding"         Value="4"/>
        </Style>
        <Style Selector="Button.thumb:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style Selector="Button.thumb.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
        </Style>
        <Style Selector="Button.del">
            <Setter Property="Width"               Value="32"/>
            <Setter Property="Height"              Value="32"/>
            <Setter Property="Padding"             Value="0"/>
            <Setter Property="FontSize"            Value="14"/>
            <Setter Property="Background"          Value="{DynamicResource HeaderBrush}"/>
            <Setter Property="Foreground"          Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Top"/>
            <Setter Property="Cursor"              Value="Arrow"/>
        </Style>
        <Style Selector="Button.del:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
        </Style>
        <Style Selector="Button.action">
            <Setter Property="Background"    Value="{DynamicResource BrandBurgundyBrush}"/>
            <Setter Property="Foreground"    Value="White"/>
            <Setter Property="Padding"       Value="12,7"/>
            <Setter Property="CornerRadius"  Value="8"/>
        </Style>
        <Style Selector="Button.action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background"     Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush"    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"     Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding"        Value="12,7"/>
            <Setter Property="MinHeight"      Value="40"/>
            <Setter Property="CornerRadius"   Value="8"/>
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" Padding="20,16">
            <StackPanel Spacing="2">
                <TextBlock Text="Cover Image" Foreground="White"
                           FontFamily="{DynamicResource HeadingFont}"
                           FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Choose an image for the bulletin cover, or leave on Random."
                           Foreground="{DynamicResource HeaderAccentBrush}" FontSize="13"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Height="3" Background="{DynamicResource GoldBrush}"/>

        <!-- Bottom button bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Classes="secondary"
                        Content="⬆  Upload image…" Click="Upload_Click"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="secondary" Content="Cancel" Width="80" Click="Cancel_Click"/>
                    <Button Classes="action"    Content="OK"     Width="80" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrollable thumbnail area -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="10,10,10,0">
            <StackPanel Spacing="8">

                <!-- Random tile -->
                <Button x:Name="RandomButton" Classes="thumb"
                        Width="140" Height="126" Margin="6"
                        HorizontalAlignment="Left" Click="Random_Click">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="6">
                        <TextBlock Text="🎲" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Random" HorizontalAlignment="Center"
                                   FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </Button>

                <TextBlock x:Name="EmptyMessage"
                           Text="No saved cover images yet. Upload one to add it to your library."
                           IsVisible="False" FontSize="13" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="12,8"
                           Foreground="{DynamicResource MutedBrush}"/>

                <!-- Library thumbnails -->
                <WrapPanel x:Name="ThumbPanel" Orientation="Horizontal"/>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
