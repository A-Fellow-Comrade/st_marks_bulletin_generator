<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="st_mark_bulletin_generator.Views.CalendarWindow"
        Title="St. Mark Bulletins"
        Width="1000" Height="721" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        Background="{DynamicResource SurfaceBrush}">

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="BorderBrush"   Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"    Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding"       Value="10,6"/>
            <Setter Property="CornerRadius"  Value="4"/>
            <Setter Property="FontSize"      Value="12"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        </Style>
        <Style Selector="Button.today">
            <Setter Property="Background"    Value="{DynamicResource BrandBurgundyBrush}"/>
            <Setter Property="Foreground"    Value="White"/>
            <Setter Property="Padding"       Value="10,6"/>
            <Setter Property="CornerRadius"  Value="4"/>
            <Setter Property="FontSize"      Value="12"/>
        </Style>
        <Style Selector="Button.today:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#7A2340"/>
        </Style>

        <!-- Theme toggle (visible on the dark header bar) -->
        <Style Selector="Button.theme-toggle">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandGoldBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Padding"     Value="8,4"/>
            <Setter Property="FontSize"    Value="12"/>
        </Style>
        <Style Selector="Button.theme-toggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandGoldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandBurgundyBrush}"/>
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- Header (pinned) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BrandBurgundyBrush}" Padding="18,14">
            <StackPanel Spacing="2">
                <TextBlock Text="St. Mark Bulletin Generator"
                           Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Select a Sunday to open its bulletin"
                           Foreground="#C0A060" FontSize="12"/>
                <StackPanel Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="SettingsButton" Classes="theme-toggle"
                            Click="Settings_Click"
                            ToolTip.Tip="The wording printed on every bulletin: church name, contact details and so on">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconGear}" Width="14" Height="14"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ThemeToggle" Classes="theme-toggle"
                            Click="ThemeToggle_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon x:Name="ThemeSunIcon" Data="{StaticResource IconSun}" Width="14" Height="14"/>
                            <PathIcon x:Name="ThemeMoonIcon" Data="{StaticResource IconMoon}" Width="14" Height="14" IsVisible="False"/>
                            <TextBlock x:Name="ThemeLabel" Text="Light" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Scrollable body -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,14,16,16" Spacing="10">

            <!-- Folder info card -->
            <Border x:Name="FolderBorder" CornerRadius="6" Padding="14,10"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="FolderText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource LabelBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="nav" Content="Choose folder…" Click="ChooseFolder_Click"/>
                        <Button Classes="nav" x:Name="RetryButton" Content="Try again"
                                IsVisible="False" Click="Retry_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Month navigation -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                <Button Grid.Column="0" Classes="nav" Padding="12,6" Click="PrevMonth_Click"
                        ToolTip.Tip="Previous month">
                    <PathIcon Data="{StaticResource IconChevronLeft}" Width="14" Height="14"/>
                </Button>
                <TextBlock Grid.Column="1" x:Name="MonthTitle"
                           FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Classes="nav" Padding="12,6" Click="NextMonth_Click"
                        ToolTip.Tip="Next month">
                    <PathIcon Data="{StaticResource IconChevronRight}" Width="14" Height="14"/>
                </Button>
            </Grid>

            <!-- Calendar card -->
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="10">
                <StackPanel Spacing="4">
                    <!-- Day-of-week headers -->
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="Sun" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrandBurgundyBrush}" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="Mon" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="Tue" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="3" Text="Wed" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="4" Text="Thu" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="5" Text="Fri" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="6" Text="Sat" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" FontSize="12"/>
                    </Grid>

                    <!-- Day cells — filled from code-behind -->
                    <Grid x:Name="WeekGrid"
                          ColumnDefinitions="*,*,*,*,*,*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"/>
                </StackPanel>
            </Border>

            <!-- Selected Sunday info -->
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="14,10">
                <StackPanel Spacing="3">
                    <TextBlock x:Name="SelectedTitle" FontWeight="SemiBold"
                               FontSize="13" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SelectedInfo" Foreground="{DynamicResource MutedBrush}"
                               FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Quick navigation buttons -->
            <Grid ColumnDefinitions="*,*,*">
                <Button Grid.Column="0" Classes="nav" x:Name="PrevSundayButton"
                        Padding="8,6" Margin="0,0,4,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="PrevSunday_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconChevronLeft}" Width="12" Height="12"/>
                        <TextBlock Text="Previous" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="today" x:Name="ThisSundayButton"
                        Content="This Sunday" Padding="8,6" Margin="2,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="ThisSunday_Click"/>
                <Button Grid.Column="2" Classes="nav" x:Name="NextSundayButton"
                        Padding="8,6" Margin="4,0,0,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="NextSunday_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Next" VerticalAlignment="Center"/>
                        <PathIcon Data="{StaticResource IconChevronRight}" Width="12" Height="12"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Legend -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                <Border Width="14" Height="14" CornerRadius="3"
                        Background="#66FFB300" VerticalAlignment="Center"/>
                <TextBlock Text="Saved bulletin" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                           VerticalAlignment="Center"/>
                <Border Width="14" Height="14" CornerRadius="3"
                        Background="#5C1A2E" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock Text="Selected Sunday" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                           VerticalAlignment="Center"/>
            </StackPanel>
c
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
