<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="st_mark_bulletin_generator.Views.CalendarWindow"
        Title="St. Mark Bulletins"
        Width="440" Height="680" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        Background="#FAF7F4">

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="BorderBrush"   Value="#C0B0A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"    Value="#3A2A1A"/>
            <Setter Property="Padding"       Value="10,6"/>
            <Setter Property="CornerRadius"  Value="4"/>
            <Setter Property="FontSize"      Value="12"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#EEE8E0"/>
        </Style>
        <Style Selector="Button.today">
            <Setter Property="Background"    Value="#5C1A2E"/>
            <Setter Property="Foreground"    Value="White"/>
            <Setter Property="Padding"       Value="10,6"/>
            <Setter Property="CornerRadius"  Value="4"/>
            <Setter Property="FontSize"      Value="12"/>
        </Style>
        <Style Selector="Button.today:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#7A2340"/>
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- Header (pinned) -->
        <Border DockPanel.Dock="Top" Background="#5C1A2E" Padding="18,14">
            <StackPanel Spacing="2">
                <TextBlock Text="St. Mark Bulletin Generator"
                           Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Select a Sunday to open its bulletin"
                           Foreground="#C0A060" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Scrollable body -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,14,16,16" Spacing="10">

            <!-- Folder info card -->
            <Border x:Name="FolderBorder" CornerRadius="6" Padding="14,10"
                    Background="#FFFFFF" BorderBrush="#E0D8D0" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="FolderText" FontSize="12" TextWrapping="Wrap"
                               Foreground="#5A4A3A"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="nav" Content="Choose folder…" Click="ChooseFolder_Click"/>
                        <Button Classes="nav" x:Name="RetryButton" Content="Try again"
                                IsVisible="False" Click="Retry_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Month navigation -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                <Button Grid.Column="0" Classes="nav" Content="◀" Padding="12,6" Click="PrevMonth_Click"/>
                <TextBlock Grid.Column="1" x:Name="MonthTitle"
                           FontSize="17" FontWeight="SemiBold" Foreground="#3A2A1A"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Classes="nav" Content="▶" Padding="12,6" Click="NextMonth_Click"/>
            </Grid>

            <!-- Calendar card -->
            <Border Background="#FFFFFF" BorderBrush="#E0D8D0" BorderThickness="1"
                    CornerRadius="6" Padding="10">
                <StackPanel Spacing="4">
                    <!-- Day-of-week headers -->
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="Sun" FontWeight="SemiBold"
                                   Foreground="#5C1A2E" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="Mon" Foreground="#A09080"
                                   HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="Tue" Foreground="#A09080"
                                   HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="3" Text="Wed" Foreground="#A09080"
                                   HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="4" Text="Thu" Foreground="#A09080"
                                   HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="5" Text="Fri" Foreground="#A09080"
                                   HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="6" Text="Sat" Foreground="#A09080"
                                   HorizontalAlignment="Center" FontSize="12"/>
                    </Grid>

                    <!-- Day cells — filled from code-behind -->
                    <Grid x:Name="WeekGrid"
                          ColumnDefinitions="*,*,*,*,*,*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"/>
                </StackPanel>
            </Border>

            <!-- Selected Sunday info -->
            <Border Background="#FFFFFF" BorderBrush="#E0D8D0" BorderThickness="1"
                    CornerRadius="6" Padding="14,10">
                <StackPanel Spacing="3">
                    <TextBlock x:Name="SelectedTitle" FontWeight="SemiBold"
                               FontSize="13" Foreground="#3A2A1A" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SelectedInfo" Foreground="#7A6A5A"
                               FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Quick navigation buttons -->
            <Grid ColumnDefinitions="*,*,*">
                <Button Grid.Column="0" Classes="nav" x:Name="PrevSundayButton"
                        Content="◀ Previous" Padding="8,6" Margin="0,0,4,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="PrevSunday_Click"/>
                <Button Grid.Column="1" Classes="today" x:Name="ThisSundayButton"
                        Content="This Sunday" Padding="8,6" Margin="2,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="ThisSunday_Click"/>
                <Button Grid.Column="2" Classes="nav" x:Name="NextSundayButton"
                        Content="Next ▶" Padding="8,6" Margin="4,0,0,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="NextSunday_Click"/>
            </Grid>

            <!-- Legend -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                <Border Width="14" Height="14" CornerRadius="3"
                        Background="#66FFB300" VerticalAlignment="Center"/>
                <TextBlock Text="Saved bulletin" Foreground="#7A6A5A" FontSize="11"
                           VerticalAlignment="Center"/>
                <Border Width="14" Height="14" CornerRadius="3"
                        Background="#5C1A2E" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock Text="Selected Sunday" Foreground="#7A6A5A" FontSize="11"
                           VerticalAlignment="Center"/>
            </StackPanel>

        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
