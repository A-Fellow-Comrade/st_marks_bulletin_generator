<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="st_mark_bulletin_generator.Views.CalendarWindow"
        Title="St. Mark Bulletins"
        Width="1000" Height="721" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        Background="{DynamicResource SurfaceBrush}">

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="BorderBrush"   Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"    Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding"       Value="10,6"/>
            <Setter Property="CornerRadius"  Value="4"/>
            <Setter Property="FontSize"      Value="12"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        </Style>
        <Style Selector="Button.today">
            <Setter Property="Background"    Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground"    Value="White"/>
            <Setter Property="Padding"       Value="10,6"/>
            <Setter Property="CornerRadius"  Value="4"/>
            <Setter Property="FontSize"      Value="12"/>
        </Style>
        <Style Selector="Button.today:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
        </Style>

        <!-- Theme toggle (visible on the dark header bar) -->
        <Style Selector="Button.theme-toggle">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Padding"     Value="8,4"/>
            <Setter Property="FontSize"    Value="12"/>
        </Style>
        <Style Selector="Button.theme-toggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource GoldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandBurgundyBrush}"/>
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- Header (pinned) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" Padding="18,14">
            <Grid ColumnDefinitions="Auto,*">
                <PathIcon Grid.Column="0" Data="{StaticResource IconCross}" Width="16" Height="24"
                          Foreground="#E8C97A" VerticalAlignment="Top" Margin="0,2,14,0"/>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="St. Mark Bulletin Generator"
                               FontFamily="{DynamicResource HeadingFont}"
                               Foreground="White" FontSize="21"/>
                    <TextBlock Text="Select a Sunday to open its bulletin"
                               FontFamily="{DynamicResource HeadingFont}" FontStyle="Italic"
                               Foreground="#E8C97A" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="SettingsButton" Classes="theme-toggle"
                                Click="Settings_Click"
                                ToolTip.Tip="The wording printed on every bulletin: church name, contact details and so on">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconGear}" Width="14" Height="14"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ThemeToggle" Classes="theme-toggle"
                                Click="ThemeToggle_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon x:Name="ThemeSunIcon" Data="{StaticResource IconSun}" Width="14" Height="14"/>
                                <PathIcon x:Name="ThemeMoonIcon" Data="{StaticResource IconMoon}" Width="14" Height="14" IsVisible="False"/>
                                <TextBlock x:Name="ThemeLabel" Text="Light" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Gilt double rule under the header -->
        <StackPanel DockPanel.Dock="Top" Spacing="2">
            <Border Height="3" Background="{DynamicResource GoldBrush}"/>
            <Border Height="1" Background="{DynamicResource GoldBrush}"/>
        </StackPanel>

        <!-- Scrollable body -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,14,16,16" Spacing="10">

            <!-- Folder info card -->
            <Border x:Name="FolderBorder" CornerRadius="6" Padding="14,10"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="FolderText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource LabelBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="nav" Content="Choose folder…" Click="ChooseFolder_Click"/>
                        <Button Classes="nav" x:Name="RetryButton" Content="Try again"
                                IsVisible="False" Click="Retry_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Month navigation -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                <Button Grid.Column="0" Classes="nav" Padding="12,6" Click="PrevMonth_Click"
                        ToolTip.Tip="Previous month">
                    <PathIcon Data="{StaticResource IconChevronLeft}" Width="14" Height="14"/>
                </Button>
                <TextBlock Grid.Column="1" x:Name="MonthTitle"
                           FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Classes="nav" Padding="12,6" Click="NextMonth_Click"
                        ToolTip.Tip="Next month">
                    <PathIcon Data="{StaticResource IconChevronRight}" Width="14" Height="14"/>
                </Button>
            </Grid>

            <!-- Calendar card -->
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="10">
                <StackPanel Spacing="4">
                    <!-- Day-of-week headers -->
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="Sun" FontWeight="SemiBold"
                                   Foreground="{DynamicResource RubricBrush}" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="Mon" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="Tue" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="3" Text="Wed" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="4" Text="Thu" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="5" Text="Fri" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="6" Text="Sat" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" FontSize="12"/>
                    </Grid>

                    <!-- Day cells — filled from code-behind -->
                    <Grid x:Name="WeekGrid"
                          ColumnDefinitions="*,*,*,*,*,*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"/>
                </StackPanel>
            </Border>

            <!-- Selected Sunday info -->
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" ClipToBounds="True">
                <Grid ColumnDefinitions="6,*">
                    <!-- The color of the church year for this Sunday -->
                    <Border x:Name="SelectedEdge" Grid.Column="0" Background="{DynamicResource GoldBrush}"/>
                    <StackPanel Grid.Column="1" Spacing="3" Margin="14,10">
                        <TextBlock x:Name="SelectedTitle"
                                   FontFamily="{DynamicResource HeadingFont}" FontSize="16"
                                   Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedSeason"
                                   FontFamily="{DynamicResource HeadingFont}" FontStyle="Italic" FontSize="13"
                                   Foreground="{DynamicResource RubricBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedInfo" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quick navigation buttons -->
            <Grid ColumnDefinitions="*,*,*">
                <Button Grid.Column="0" Classes="nav" x:Name="PrevSundayButton"
                        Padding="8,6" Margin="0,0,4,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="PrevSunday_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconChevronLeft}" Width="12" Height="12"/>
                        <TextBlock Text="Previous" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="today" x:Name="ThisSundayButton"
                        Content="This Sunday" Padding="8,6" Margin="2,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="ThisSunday_Click"/>
                <Button Grid.Column="2" Classes="nav" x:Name="NextSundayButton"
                        Padding="8,6" Margin="4,0,0,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="NextSunday_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Next" VerticalAlignment="Center"/>
                        <PathIcon Data="{StaticResource IconChevronRight}" Width="12" Height="12"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Legend -->
            <StackPanel Spacing="6" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="14" Height="14" CornerRadius="3"
                            Background="{DynamicResource GoldBrush}" Opacity="0.35" VerticalAlignment="Center"/>
                    <TextBlock Text="Saved bulletin" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                               VerticalAlignment="Center"/>
                    <Border Width="14" Height="14" CornerRadius="3"
                            Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Text="Selected Sunday" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Church year:" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                               VerticalAlignment="Center"/>
                    <Border Width="4" Height="14" CornerRadius="2"
                            Background="{DynamicResource SeasonWhiteBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="White" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                    <Border Width="4" Height="14" CornerRadius="2" Margin="6,0,0,0"
                            Background="{DynamicResource SeasonGreenBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Green" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                    <Border Width="4" Height="14" CornerRadius="2" Margin="6,0,0,0"
                            Background="{DynamicResource SeasonVioletBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Violet" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                    <Border Width="4" Height="14" CornerRadius="2" Margin="6,0,0,0"
                            Background="{DynamicResource SeasonRedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Red" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
