<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rte="using:AvaloniaRichEditor.Controls"
        x:Class="st_mark_bulletin_generator.Views.MainWindow"
        Title="St. Mark Bulletin Generator"
        Width="700" Height="820" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        Background="{DynamicResource SurfaceBrush}">

    <Window.Styles>
        <!-- Form labels -->
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground"       Value="{DynamicResource LabelBrush}"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"           Value="0,0,12,0"/>
        </Style>

        <!-- All text boxes -->
        <Style Selector="TextBox">
            <Setter Property="Background"     Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush"    Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Margin"         Value="0,3"/>
            <Setter Property="CornerRadius"   Value="4"/>
        </Style>

        <!-- All combo boxes -->
        <Style Selector="ComboBox">
            <Setter Property="Background"  Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Margin"      Value="0,3"/>
        </Style>

        <!-- Primary action button (Generate PDF) -->
        <Style Selector="Button.primary">
            <Setter Property="Background"              Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground"              Value="White"/>
            <Setter Property="FontSize"                Value="14"/>
            <Setter Property="FontWeight"              Value="SemiBold"/>
            <Setter Property="Padding"                 Value="0,14"/>
            <Setter Property="HorizontalAlignment"     Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius"            Value="6"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
        </Style>

        <!-- Secondary buttons -->
        <Style Selector="Button.secondary">
            <Setter Property="Background"  Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"  Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding"     Value="10,6"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <!-- Theme toggle (visible on the dark header bar) -->
        <Style Selector="Button.theme-toggle">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Padding"     Value="8,4"/>
            <Setter Property="FontSize"    Value="12"/>
        </Style>
        <Style Selector="Button.theme-toggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource GoldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandBurgundyBrush}"/>
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- ══════════════ HEADER (pinned) ══════════════ -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" Padding="20,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Grid.Column="0" Data="{StaticResource IconCross}" Width="16" Height="24"
                          Foreground="#E8C97A" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="St. Mark Bulletin Generator"
                               FontFamily="{DynamicResource HeadingFont}"
                               Foreground="White" FontSize="21"/>
                    <TextBlock x:Name="SundayLabel"
                               FontFamily="{DynamicResource HeadingFont}" FontStyle="Italic"
                               Foreground="#E8C97A" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="SaveNote"
                               Foreground="#C0A060" FontSize="11"
                               HorizontalAlignment="Right" TextWrapping="Wrap"/>
                    <Button x:Name="ThemeToggle" Classes="theme-toggle"
                            Click="ThemeToggle_Click"
                            HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon x:Name="ThemeSunIcon" Data="{StaticResource IconSun}" Width="14" Height="14"/>
                            <PathIcon x:Name="ThemeMoonIcon" Data="{StaticResource IconMoon}" Width="14" Height="14" IsVisible="False"/>
                            <TextBlock x:Name="ThemeLabel" Text="Light" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Gilt double rule under the header -->
        <StackPanel DockPanel.Dock="Top" Spacing="2">
            <!-- The first line takes the color of the church year for the Sunday being edited -->
            <Border x:Name="SeasonStripe" Height="4" Background="{DynamicResource GoldBrush}"/>
            <Border Height="1" Background="{DynamicResource GoldBrush}"/>
        </StackPanel>

        <!-- ══════════════ SCROLLABLE BODY ══════════════ -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,14,16,16" Spacing="0">

            <!-- Conflict / sync banner -->
            <Border x:Name="BannerBorder" IsVisible="False"
                    Background="#FFF3CD" BorderBrush="#F0C040" BorderThickness="1"
                    CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconWarning}" Width="16" Height="16" VerticalAlignment="Center" Foreground="#8A6000"/>
                        <TextBlock x:Name="BannerText" TextWrapping="Wrap"
                                   Foreground="#5A4000" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="ConflictButtons" Orientation="Horizontal" Spacing="8" IsVisible="False">
                        <Button Classes="secondary" Content="Keep mine"        Click="KeepMine_Click"/>
                        <Button Classes="secondary" Content="Use their version" Click="UseTheirs_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── CARD: Service Info ── -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="Service information"/>
                    <Border Classes="rule"/>
                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto">

                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Service time"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="ServiceTimeBox"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Sunday name"
                                   ToolTip.Tip="Printed on the back cover as: Today is ____."/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="SundayNameBox"
                                   ToolTip.Tip="Printed on the back cover as: Today is ____."/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Presiding minister"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="MinisterBox"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Organist"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="OrganistBox"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── CARD: Worship Details ── -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="Worship details"/>
                    <Border Classes="rule"/>
                    <Grid ColumnDefinitions="130,160,*" RowDefinitions="Auto,Auto">

                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Service setting"/>
                        <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="SettingBox"
                                   HorizontalAlignment="Stretch"
                                   SelectionChanged="SettingBox_SelectionChanged">
                            <ComboBoxItem>Setting One</ComboBoxItem>
                            <ComboBoxItem>Setting Two</ComboBoxItem>
                            <ComboBoxItem>Setting Three</ComboBoxItem>
                            <ComboBoxItem>Setting Four</ComboBoxItem>
                            <ComboBoxItem>Setting Five</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="SettingPageLabel"
                                   Classes="label" Margin="12,0,0,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Creed"/>
                        <ComboBox  Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="CreedBox"
                                   SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem>Nicene or Apostles' Creed</ComboBoxItem>
                            <ComboBoxItem>Nicene Creed</ComboBoxItem>
                            <ComboBoxItem>Apostles' Creed</ComboBoxItem>
                            <ComboBoxItem>Athanasian Creed</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── CARD: Hymns & Music ── -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="Hymns &amp; music"/>
                    <Border Classes="rule"/>
                    <Grid ColumnDefinitions="130,100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Organ prelude"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="PreludeBox"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Opening hymn #"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="OpeningHymnBox"
                                   Tag="OpeningTitle" TextChanged="HymnBox_TextChanged"/>
                        <TextBox   Grid.Row="1" Grid.Column="2" x:Name="OpeningTitle"
                                   Margin="8,3,0,3" Tag="OpeningHymnBox" LostFocus="Title_LostFocus"
                                   Watermark="Hymn title"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Hymn of the Day #"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="DayHymnBox"
                                   Tag="DayTitle" TextChanged="HymnBox_TextChanged"/>
                        <TextBox   Grid.Row="2" Grid.Column="2" x:Name="DayTitle"
                                   Margin="8,3,0,3" Tag="DayHymnBox" LostFocus="Title_LostFocus"
                                   Watermark="Hymn title"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Closing hymn #"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="ClosingHymnBox"
                                   Tag="ClosingTitle" TextChanged="HymnBox_TextChanged"/>
                        <TextBox   Grid.Row="3" Grid.Column="2" x:Name="ClosingTitle"
                                   Margin="8,3,0,3" Tag="ClosingHymnBox" LostFocus="Title_LostFocus"
                                   Watermark="Hymn title"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="Organ postlude"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="PostludeBox"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── CARD: Psalm ── -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="Psalm"/>
                    <Border Classes="rule"/>
                    <Grid ColumnDefinitions="130,100,Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
                       
                       <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Psalm"/>

                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="PsalmNumberBox"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text=":" FontSize="16"
                                FontWeight="SemiBold" Margin="8,0,2,0"
                                VerticalAlignment="Center"/>

                        <TextBox Grid.Row="0" Grid.Column="3"
                                x:Name="PsalmVersesBox"
                                Watermark="Blank = the whole psalm. Examples: 1-9 or 1-5, 8"/>

                        <ComboBox Grid.Row="0" Grid.Column="4" x:Name="PsalmVersionBox"
                                MinWidth="90"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                    Orientation="Horizontal" Spacing="12">
                            <CheckBox x:Name="PsalmOptionalBox" Content="Include optional verses"
                                      VerticalAlignment="Center"/>
                            <Button Classes="secondary" Content="Use appointed psalm"
                                    Click="UseAppointed_Click"/>
                        </StackPanel>

                         <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Lectionary"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                                  x:Name="LectionaryBox" SelectedIndex="0">
                            <ComboBoxItem>Three-year lectionary</ComboBoxItem>
                            <ComboBoxItem>One-year lectionary</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── CARD: Announcements ── -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="Announcements"/>
                    <Border Classes="rule"/>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <rte:RichEditorView x:Name="AnnouncementsBox" Height="200" ShowStatusBar="False"/>
                            <Border x:Name="AnnouncementsPlaceholder"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource GoldBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                                <TextBlock Text="Type here...&#10;Put each new announcement on its own line."
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── CARD: Acknowledgements ── -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="Acknowledgements"/>
                    <Border Classes="rule"/>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <rte:RichEditorView x:Name="AcknowledgementsBox" Height="140" ShowStatusBar="False"/>
                            <Border x:Name="AcknowledgementsPlaceholder"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource GoldBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                                <TextBlock Text="Type here...&#10;Thank the people who helped this Sunday, one per line."
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>


            <!-- ── CARD: Cover Image ── -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="Cover image"/>
                    <Border Classes="rule"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Classes="secondary" x:Name="PickImageButton" Click="PickImage_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconImage}" Width="16" Height="16"/>
                                <TextBlock Text="Choose image…" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="PickImageLabel" Text="Random"
                                   VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontStyle="Italic"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Generate button ── -->
            <Button Classes="primary" Content="Generate PDF"
                    Margin="0,4,0,0" Click="Generate_Click"/>

            <!-- Status text -->
            <TextBlock x:Name="StatusText"
                       Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource LabelBrush}" FontSize="12"/>

        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
