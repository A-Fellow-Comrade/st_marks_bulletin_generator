<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="st_mark_bulletin_generator.Views.MainWindow"
        Title="St. Mark Bulletin Generator"
        Width="700" Height="820" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        Background="#FAF7F4">

    <Window.Styles>
        <!-- Section card -->
        <Style Selector="Border.card">
            <Setter Property="Background"     Value="#FFFFFF"/>
            <Setter Property="BorderBrush"    Value="#E0D8D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"   Value="6"/>
            <Setter Property="Padding"        Value="16,12"/>
            <Setter Property="Margin"         Value="0,0,0,10"/>
        </Style>

        <!-- Section heading inside a card -->
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize"       Value="10"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Foreground"     Value="#7A6A5A"/>
            <Setter Property="Margin"         Value="0,0,0,10"/>
            <Setter Property="LetterSpacing"  Value="1.5"/>
        </Style>

        <!-- Form labels -->
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground"       Value="#5A4A3A"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"           Value="0,0,12,0"/>
        </Style>

        <!-- All text boxes -->
        <Style Selector="TextBox">
            <Setter Property="Background"     Value="#FDFBF9"/>
            <Setter Property="BorderBrush"    Value="#D0C8C0"/>
            <Setter Property="Margin"         Value="0,3"/>
            <Setter Property="CornerRadius"   Value="4"/>
        </Style>

        <!-- All combo boxes -->
        <Style Selector="ComboBox">
            <Setter Property="Background"  Value="#FDFBF9"/>
            <Setter Property="BorderBrush" Value="#D0C8C0"/>
            <Setter Property="Margin"      Value="0,3"/>
        </Style>

        <!-- Primary action button (Generate PDF) -->
        <Style Selector="Button.primary">
            <Setter Property="Background"              Value="#5C1A2E"/>
            <Setter Property="Foreground"              Value="White"/>
            <Setter Property="FontSize"                Value="14"/>
            <Setter Property="FontWeight"              Value="SemiBold"/>
            <Setter Property="Padding"                 Value="0,14"/>
            <Setter Property="HorizontalAlignment"     Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius"            Value="6"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#7A2340"/>
        </Style>

        <!-- Secondary buttons -->
        <Style Selector="Button.secondary">
            <Setter Property="Background"  Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C0B0A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"  Value="#3A2A1A"/>
            <Setter Property="Padding"     Value="10,6"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- ══════════════ HEADER (pinned) ══════════════ -->
        <Border DockPanel.Dock="Top" Background="#5C1A2E" Padding="20,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="St. Mark Bulletin Generator"
                               Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SundayLabel"
                               Foreground="#E8C97A" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="SaveNote"
                               Foreground="#C0A060" FontSize="11"
                               HorizontalAlignment="Right" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════ SCROLLABLE BODY ══════════════ -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,14,16,16" Spacing="0">

            <!-- Conflict / sync banner -->
            <Border x:Name="BannerBorder" IsVisible="False"
                    Background="#FFF3CD" BorderBrush="#F0C040" BorderThickness="1"
                    CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚠" FontSize="14" VerticalAlignment="Center" Foreground="#8A6000"/>
                        <TextBlock x:Name="BannerText" TextWrapping="Wrap"
                                   Foreground="#5A4000" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="ConflictButtons" Orientation="Horizontal" Spacing="8" IsVisible="False">
                        <Button Classes="secondary" Content="Keep mine"        Click="KeepMine_Click"/>
                        <Button Classes="secondary" Content="Use their version" Click="UseTheirs_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── CARD: Service Info ── -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="SERVICE INFORMATION"/>
                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto">

                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Service time"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="ServiceTimeBox"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Sunday name"
                                   ToolTip.Tip="Printed on the back cover as: Today is ____."/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="SundayNameBox"
                                   ToolTip.Tip="Printed on the back cover as: Today is ____."/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Presiding minister"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="MinisterBox"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Organist"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="OrganistBox"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── CARD: Worship Details ── -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="WORSHIP DETAILS"/>
                    <Grid ColumnDefinitions="130,160,*" RowDefinitions="Auto,Auto">

                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Service setting"/>
                        <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="SettingBox"
                                   HorizontalAlignment="Stretch"
                                   SelectionChanged="SettingBox_SelectionChanged">
                            <ComboBoxItem>Setting One</ComboBoxItem>
                            <ComboBoxItem>Setting Two</ComboBoxItem>
                            <ComboBoxItem>Setting Three</ComboBoxItem>
                            <ComboBoxItem>Setting Four</ComboBoxItem>
                            <ComboBoxItem>Setting Five</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="SettingPageLabel"
                                   Classes="label" Margin="12,0,0,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Creed"/>
                        <ComboBox  Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="CreedBox"
                                   SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem>Nicene or Apostles' Creed</ComboBoxItem>
                            <ComboBoxItem>Nicene Creed</ComboBoxItem>
                            <ComboBoxItem>Apostles' Creed</ComboBoxItem>
                            <ComboBoxItem>Athanasian Creed</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── CARD: Hymns & Music ── -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="HYMNS &amp; MUSIC"/>
                    <Grid ColumnDefinitions="130,100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Organ prelude"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="PreludeBox"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Opening hymn #"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="OpeningHymnBox"
                                   Tag="OpeningTitle" TextChanged="HymnBox_TextChanged"/>
                        <TextBox   Grid.Row="1" Grid.Column="2" x:Name="OpeningTitle"
                                   Margin="8,3,0,3" Tag="OpeningHymnBox" LostFocus="Title_LostFocus"
                                   Watermark="Hymn title"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Hymn of the Day #"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="DayHymnBox"
                                   Tag="DayTitle" TextChanged="HymnBox_TextChanged"/>
                        <TextBox   Grid.Row="2" Grid.Column="2" x:Name="DayTitle"
                                   Margin="8,3,0,3" Tag="DayHymnBox" LostFocus="Title_LostFocus"
                                   Watermark="Hymn title"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Closing hymn #"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="ClosingHymnBox"
                                   Tag="ClosingTitle" TextChanged="HymnBox_TextChanged"/>
                        <TextBox   Grid.Row="3" Grid.Column="2" x:Name="ClosingTitle"
                                   Margin="8,3,0,3" Tag="ClosingHymnBox" LostFocus="Title_LostFocus"
                                   Watermark="Hymn title"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="Organ postlude"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="PostludeBox"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── CARD: Announcements ── -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="ANNOUNCEMENTS"/>
                    <TextBox x:Name="AnnouncementsBox"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="100"
                             Watermark="One announcement per line…"/>
                </StackPanel>
            </Border>

            <!-- ── CARD: Cover Image ── -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="COVER IMAGE"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Classes="secondary" x:Name="PickImageButton"
                                Content="🖼  Choose image…" Click="PickImage_Click"/>
                        <TextBlock x:Name="PickImageLabel" Text="Random"
                                   VerticalAlignment="Center" Foreground="#7A6A5A" FontStyle="Italic"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Generate button ── -->
            <Button Classes="primary" Content="Generate PDF"
                    Margin="0,4,0,0" Click="Generate_Click"/>

            <!-- Status text -->
            <TextBlock x:Name="StatusText"
                       Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="#5A4A3A" FontSize="12"/>

        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
