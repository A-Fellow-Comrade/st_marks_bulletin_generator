<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="st_mark_bulletin_generator.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <!-- Buttons, check boxes and focus rings use burgundy (gold-rose in dark mode) instead of Fluent's blue -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#5C1A2E"/>
                <ColorPaletteResources x:Key="Dark" Accent="#B98498"/>
            </FluentTheme.Palettes>
        </FluentTheme>

        <!-- Shared look of the cards in the bulletin form and the settings window -->
        <Style Selector="Border.card">
            <Setter Property="Background"     Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush"    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"   Value="12"/>
            <Setter Property="Padding"        Value="20,16"/>
            <Setter Property="Margin"         Value="0,0,0,14"/>
        </Style>

        <Style Selector="TextBlock.section-title">
            <Setter Property="FontFamily"     Value="{DynamicResource HeadingFont}"/>
            <Setter Property="FontSize"       Value="16"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Foreground"     Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin"         Value="0,0,0,6"/>
        </Style>

        <Style Selector="Border.rule">
            <Setter Property="Height"         Value="2"/>
            <Setter Property="Background"     Value="{DynamicResource GoldBrush}"/>
            <Setter Property="Opacity"        Value="0.55"/>
            <Setter Property="Margin"         Value="0,0,0,10"/>
        </Style>
    </Application.Styles>
    <Application.Resources>
        <!-- Brand colours (same in both modes) -->
        <Color x:Key="BrandBurgundy">#5C1A2E</Color>
        <Color x:Key="BrandGold">#B8860B</Color>

        <SolidColorBrush x:Key="BrandBurgundyBrush" Color="{StaticResource BrandBurgundy}"/>
        <SolidColorBrush x:Key="BrandGoldBrush"     Color="{StaticResource BrandGold}"/>

        <!-- Calendar mark colours (same in both modes) -->
        <SolidColorBrush x:Key="SavedMarkBrush" Color="#66FFB300"/>
        <SolidColorBrush x:Key="SelectedMarkBrush" Color="{StaticResource BrandBurgundy}"/>
        <SolidColorBrush x:Key="SeasonDarkTextBrush" Color="#302A28"/>

        <!-- Heading typeface: Georgia on every Windows and Mac computer (Cambria / Times New Roman as back-ups) -->
        <FontFamily x:Key="HeadingFont">Georgia,Cambria,Times New Roman</FontFamily>

        <!--
            Colours that change between light and dark mode.
            Each name below has a light version ("<Name>") and a dark version ("Dark<Name>");
            App.axaml.cs swaps them when the theme is switched (see ThemedBrushes there).
            Light = parchment, ivory, burgundy and gold.  Dark = candlelit: wine-black, parchment text, gold.
        -->

        <!-- ──────── Light: parchment ──────── -->
        <Color x:Key="LightSurface">#F7F5F1</Color>
        <Color x:Key="LightCard">#FFFEFC</Color>
        <Color x:Key="LightBorder">#E7E1D8</Color>
        <Color x:Key="LightInputBackground">#FFFFFF</Color>
        <Color x:Key="LightInputBorder">#CDC4B8</Color>
        <Color x:Key="LightText">#302A28</Color>
        <Color x:Key="LightLabel">#554A45</Color>
        <Color x:Key="LightMuted">#786D67</Color>

        <SolidColorBrush x:Key="SurfaceBrush"      Color="{StaticResource LightSurface}"/>
        <SolidColorBrush x:Key="CardBrush"         Color="{StaticResource LightCard}"/>
        <SolidColorBrush x:Key="BorderBrush"       Color="{StaticResource LightBorder}"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource LightInputBackground}"/>
        <SolidColorBrush x:Key="InputBorderBrush"     Color="{StaticResource LightInputBorder}"/>
        <SolidColorBrush x:Key="TextBrush"         Color="{StaticResource LightText}"/>
        <SolidColorBrush x:Key="LabelBrush"        Color="{StaticResource LightLabel}"/>
        <SolidColorBrush x:Key="MutedBrush"        Color="{StaticResource LightMuted}"/>
        <!-- Rubric red (for small instruction-style labels), gold rules, header bar, main buttons -->
        <SolidColorBrush x:Key="RubricBrush"       Color="#9B2226"/>
        <SolidColorBrush x:Key="GoldBrush"         Color="#B8860B"/>
        <SolidColorBrush x:Key="HeaderBrush"       Color="#5C1A2E"/>
        <SolidColorBrush x:Key="PrimaryBrush"      Color="#5C1A2E"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#7A2340"/>
        <SolidColorBrush x:Key="SeasonForegroundBrush" Color="#302A28"/>
        <!-- Warning notes (the yellow boxes) -->
        <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF3CD"/>
        <SolidColorBrush x:Key="WarningBorderBrush"     Color="#F0C040"/>
        <SolidColorBrush x:Key="WarningTextBrush"       Color="#5A4000"/>
        <!-- Muted church-year fills and clearer markers for the calendar. -->
        <SolidColorBrush x:Key="SeasonWhiteBrush"  Color="#E9E1CE"/>
        <SolidColorBrush x:Key="SeasonGreenBrush"  Color="#C9DEC5"/>
        <SolidColorBrush x:Key="SeasonVioletBrush" Color="#D8C8E4"/>
        <SolidColorBrush x:Key="SeasonRedBrush"    Color="#E8C4BE"/>
        <SolidColorBrush x:Key="SeasonWhiteMarkBrush"  Color="#A99569"/>
        <SolidColorBrush x:Key="SeasonGreenMarkBrush"  Color="#799A72"/>
        <SolidColorBrush x:Key="SeasonVioletMarkBrush" Color="#9277A6"/>
        <SolidColorBrush x:Key="SeasonRedMarkBrush"    Color="#B6756B"/>
        <SolidColorBrush x:Key="SeasonWhiteHoverBrush"  Color="#DED2B6"/>
        <SolidColorBrush x:Key="SeasonGreenHoverBrush"  Color="#B5D2AF"/>
        <SolidColorBrush x:Key="SeasonVioletHoverBrush" Color="#C9B6D7"/>
        <SolidColorBrush x:Key="SeasonRedHoverBrush"    Color="#DDAEA7"/>
        <SolidColorBrush x:Key="CalendarSeasonWhiteBrush"  Color="#E9E1CE"/>
        <SolidColorBrush x:Key="CalendarSeasonGreenBrush"  Color="#C9DEC5"/>
        <SolidColorBrush x:Key="CalendarSeasonVioletBrush" Color="#D8C8E4"/>
        <SolidColorBrush x:Key="CalendarSeasonRedBrush"    Color="#E8C4BE"/>
        <SolidColorBrush x:Key="CalendarSeasonWhiteMarkBrush"  Color="#A99569"/>
        <SolidColorBrush x:Key="CalendarSeasonGreenMarkBrush"  Color="#799A72"/>
        <SolidColorBrush x:Key="CalendarSeasonVioletMarkBrush" Color="#9277A6"/>
        <SolidColorBrush x:Key="CalendarSeasonRedMarkBrush"    Color="#B6756B"/>
        <SolidColorBrush x:Key="CalendarSeasonForegroundBrush" Color="#302A28"/>
        <SolidColorBrush x:Key="SavedBulletinUnderlineBrush" Color="#000000"/>

        <!-- ──────── Dark: candlelit ──────── -->
        <Color x:Key="DarkSurface">#211B1E</Color>
        <Color x:Key="DarkCard">#30272B</Color>
        <Color x:Key="DarkBorder">#59464D</Color>
        <Color x:Key="DarkInputBackground">#3B3035</Color>
        <Color x:Key="DarkInputBorder">#665158</Color>
        <Color x:Key="DarkText">#F2E6E3</Color>
        <Color x:Key="DarkLabel">#DBCAC7</Color>
        <Color x:Key="DarkMuted">#BBA8A5</Color>

        <SolidColorBrush x:Key="DarkSurfaceBrush"      Color="{StaticResource DarkSurface}"/>
        <SolidColorBrush x:Key="DarkCardBrush"         Color="{StaticResource DarkCard}"/>
        <SolidColorBrush x:Key="DarkBorderBrush"       Color="{StaticResource DarkBorder}"/>
        <SolidColorBrush x:Key="DarkInputBackgroundBrush" Color="{StaticResource DarkInputBackground}"/>
        <SolidColorBrush x:Key="DarkInputBorderBrush"     Color="{StaticResource DarkInputBorder}"/>
        <SolidColorBrush x:Key="DarkTextBrush"         Color="{StaticResource DarkText}"/>
        <SolidColorBrush x:Key="DarkLabelBrush"        Color="{StaticResource DarkLabel}"/>
        <SolidColorBrush x:Key="DarkMutedBrush"        Color="{StaticResource DarkMuted}"/>
        <SolidColorBrush x:Key="DarkRubricBrush"       Color="#E0A096"/>
        <SolidColorBrush x:Key="DarkGoldBrush"         Color="#E2C178"/>
        <SolidColorBrush x:Key="DarkHeaderBrush"       Color="#5C1A2E"/>
        <SolidColorBrush x:Key="DarkPrimaryBrush"      Color="#875063"/>
        <SolidColorBrush x:Key="DarkPrimaryHoverBrush" Color="#9C5E73"/>
        <SolidColorBrush x:Key="DarkSeasonForegroundBrush" Color="#F2E6E3"/>
        <SolidColorBrush x:Key="DarkSeasonWhiteBrush"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DarkSeasonGreenBrush"  Color="#3F654C"/>
        <SolidColorBrush x:Key="DarkSeasonVioletBrush" Color="#59466B"/>
        <SolidColorBrush x:Key="DarkSeasonRedBrush"    Color="#70484D"/>
        <SolidColorBrush x:Key="DarkSeasonWhiteMarkBrush"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DarkSeasonGreenMarkBrush"  Color="#A2D3A3"/>
        <SolidColorBrush x:Key="DarkSeasonVioletMarkBrush" Color="#C2A5D7"/>
        <SolidColorBrush x:Key="DarkSeasonRedMarkBrush"    Color="#E5A1A1"/>
        <SolidColorBrush x:Key="DarkSeasonWhiteHoverBrush"  Color="#E6E6E6"/>
        <SolidColorBrush x:Key="DarkSeasonGreenHoverBrush"  Color="#4D755B"/>
        <SolidColorBrush x:Key="DarkSeasonVioletHoverBrush" Color="#69547D"/>
        <SolidColorBrush x:Key="DarkSeasonRedHoverBrush"    Color="#81545B"/>
        <SolidColorBrush x:Key="DarkCalendarSeasonWhiteBrush"  Color="#665B46"/>
        <SolidColorBrush x:Key="DarkCalendarSeasonGreenBrush"  Color="#3F654C"/>
        <SolidColorBrush x:Key="DarkCalendarSeasonVioletBrush" Color="#59466B"/>
        <SolidColorBrush x:Key="DarkCalendarSeasonRedBrush"    Color="#70484D"/>
        <SolidColorBrush x:Key="DarkCalendarSeasonWhiteMarkBrush"  Color="#E2C987"/>
        <SolidColorBrush x:Key="DarkCalendarSeasonGreenMarkBrush"  Color="#A2D3A3"/>
        <SolidColorBrush x:Key="DarkCalendarSeasonVioletMarkBrush" Color="#C2A5D7"/>
        <SolidColorBrush x:Key="DarkCalendarSeasonRedMarkBrush"    Color="#E5A1A1"/>
        <SolidColorBrush x:Key="DarkCalendarSeasonForegroundBrush" Color="#F2E6E3"/>
        <SolidColorBrush x:Key="DarkSavedBulletinUnderlineBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DarkWarningBackgroundBrush" Color="#3D322B"/>
        <SolidColorBrush x:Key="DarkWarningBorderBrush"     Color="#957846"/>
        <SolidColorBrush x:Key="DarkWarningTextBrush"       Color="#F3DBA9"/>
        <!-- ──────── Icons (drawn in the text colour of the button they are in) ──────── -->
        <StreamGeometry x:Key="IconSun">M 12 7.2 A 4.8 4.8 0 1 0 12 16.8 A 4.8 4.8 0 1 0 12 7.2 Z M 12.95 4.4 L 12.95 1.4 L 11.05 1.4 L 11.05 4.4 Z M 18.05 7.3 L 20.17 5.18 L 18.82 3.83 L 16.7 5.95 Z M 19.6 12.95 L 22.6 12.95 L 22.6 11.05 L 19.6 11.05 Z M 16.7 18.05 L 18.82 20.17 L 20.17 18.82 L 18.05 16.7 Z M 11.05 19.6 L 11.05 22.6 L 12.95 22.6 L 12.95 19.6 Z M 5.95 16.7 L 3.83 18.82 L 5.18 20.17 L 7.3 18.05 Z M 4.4 11.05 L 1.4 11.05 L 1.4 12.95 L 4.4 12.95 Z M 7.3 5.95 L 5.18 3.83 L 3.83 5.18 L 5.95 7.3 Z</StreamGeometry>
        <StreamGeometry x:Key="IconMoon">M 21 12.79 A 9 9 0 1 1 11.21 3 A 7 7 0 0 0 21 12.79 Z</StreamGeometry>
        <StreamGeometry x:Key="IconGear">M 9.81 4.93 L 10.27 1.95 L 13.73 1.95 L 14.19 4.93 L 15.45 5.45 L 17.89 3.67 L 20.33 6.11 L 18.55 8.55 L 19.07 9.81 L 22.05 10.27 L 22.05 13.73 L 19.07 14.19 L 18.55 15.45 L 20.33 17.89 L 17.89 20.33 L 15.45 18.55 L 14.19 19.07 L 13.73 22.05 L 10.27 22.05 L 9.81 19.07 L 8.55 18.55 L 6.11 20.33 L 3.67 17.89 L 5.45 15.45 L 4.93 14.19 L 1.95 13.73 L 1.95 10.27 L 4.93 9.81 L 5.45 8.55 L 3.67 6.11 L 6.11 3.67 L 8.55 5.45 Z M 12 8.6 A 3.4 3.4 0 1 0 12 15.4 A 3.4 3.4 0 1 0 12 8.6 Z</StreamGeometry>
        <StreamGeometry x:Key="IconChevronLeft">M 15.2 3.6 L 17.3 5.7 L 11 12 L 17.3 18.3 L 15.2 20.4 L 6.8 12 Z</StreamGeometry>
        <StreamGeometry x:Key="IconChevronRight">M 8.8 3.6 L 6.7 5.7 L 13 12 L 6.7 18.3 L 8.8 20.4 L 17.2 12 Z</StreamGeometry>
        <StreamGeometry x:Key="IconCross">M 6 0 L 10 0 L 10 6 L 16 6 L 16 10 L 10 10 L 10 24 L 6 24 L 6 10 L 0 10 L 0 6 L 6 6 Z</StreamGeometry>
        <StreamGeometry x:Key="IconWarning">M 12 2.6 L 22.6 21 L 1.4 21 Z M 11 9 L 11 15 L 13 15 L 13 9 Z M 12 16.4 A 1.3 1.3 0 1 0 12 19 A 1.3 1.3 0 1 0 12 16.4 Z</StreamGeometry>
        <StreamGeometry x:Key="IconImage">M 2 4 L 22 4 L 22 20 L 2 20 Z M 4 6 L 4 18 L 20 18 L 20 6 Z M 5.6 16.4 L 10 10 L 13 14 L 15 11.6 L 18.4 16.4 Z M 16 7.6 A 1.7 1.7 0 1 0 16 11 A 1.7 1.7 0 1 0 16 7.6 Z</StreamGeometry>
    </Application.Resources>
</Application>
